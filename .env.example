# Salin ke .env untuk pengembangan lokal. JANGAN commit .env.
# Produksi: suplai lewat secret manager / variabel environment orkestrator.

# --- Database (docker compose up -d db) ---
POSTGRES_USER=student_connect
POSTGRES_PASSWORD=student_connect
POSTGRES_DB=student_connect
DATABASE_URL=postgres://student_connect:student_connect@localhost:5432/student_connect

# --- Backend (Loco) ---
LOCO_ENV=development
PORT=5150
# Kunci AES-256 brankas kredensial SIMKATMAWA. Buat: openssl rand -base64 32
CREDENTIAL_MASTER_KEY=

# --- Hanya produksi ---
HOST=https://api.kampus.ac.id
CORS_ORIGIN=https://app.kampus.ac.id
R2_BUCKET=student-connect-documents
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Tautan dokumen dilayani API sendiri di {R2_PUBLIC_BASE_URL}/{kode}.{ext} (permanen, tanpa kedaluwarsa);
# bucket R2 tetap PRIVAT. Isi dengan domain aplikasi + /files, dan teruskan /files ke API.
R2_PUBLIC_BASE_URL=https://app.kampus.ac.id/files
R2_MAX_UPLOAD_MB=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:5150

# --- SSO Portal (opsional; SSO_ENABLED=false = perilaku lama) ---
# Daftarkan aplikasi ini di Portal > Integrasi Aplikasi: nama, website, dan redirect URI (persis sama dengan SSO_REDIRECT_URI).
# Portal menampilkan token aplikasi SEKALI. Simpan di secret manager, jangan commit.
SSO_ENABLED=false
SSO_PORTAL_BASE_URL=https://portal.kampus.ac.id
SSO_PORTAL_HOST=portal.kampus.ac.id
# Hanya bila API Portal beda host dari halaman login (kosongkan bila sama):
SSO_PORTAL_API_URL=
SSO_PORTAL_API_HOST=
SSO_CLIENT_ID=
SSO_APP_TOKEN=
SSO_REDIRECT_URI=https://app.kampus.ac.id/api/sso/callback
# Slug tenant tujuan akun SSO dan data master (lihat task bootstrap).
SSO_TENANT_SLUG=
# Matikan (false) setelah login Portal terbukti stabil di produksi.
SSO_PASSWORD_LOGIN_ENABLED=true
# Cabut sesi lokal bila Portal menyatakan pengguna sudah tidak aktif (polling tiap 3 menit).
SSO_SESSION_CHECK_ENABLED=true
# false = terima callback tanpa `state` (Portal yang tidak meneruskannya); cukup cookie state browser. Melemahkan anti login-CSRF.
SSO_REQUIRE_STATE=true
# Tarik mahasiswa/pegawai dari Portal tiap hari pukul 02:00 (butuh SSO_ENABLED=true).
MASTER_SYNC_ENABLED=false

# --- Deploy dengan docker-compose.prod.yml ---
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# POSTGRES_PASSWORD wajib diisi kuat. Nilainya hanya dipakai saat volume database masih kosong;
# mengubahnya setelah itu tidak mengganti sandi yang sudah ada. DATABASE_URL disusun otomatis oleh compose.
