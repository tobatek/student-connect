# Frontend
VITE_API_BASE_URL="http://localhost:5150"

# Backend API
API_BIND_ADDRESS="127.0.0.1:5150"
DATABASE_URL="postgres://student_connect:student_connect@localhost:5432/student_connect"
APP_ENV="development"
APP_PUBLIC_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"
SESSION_SECRET="change-me-with-a-long-random-value"
CREDENTIAL_MASTER_KEY="change-me-32-byte-minimum-secret"

# SIMKATMAWA credentials are submitted to the backend and encrypted at rest.
SIMKATMAWA_DEFAULT_API_URL="https://simkatmawa.kemdiktisaintek.go.id"

# Cloudflare R2 / S3-compatible storage. Never expose these values to the browser.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="student-connect-documents"
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_BASE_URL="https://dokumen.example.ac.id"
R2_REGION="auto"
R2_MAX_UPLOAD_MB="15"
