{
  "name": "students-connect",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @students-connect/web dev",
    "dev:web": "pnpm --filter @students-connect/web dev",
    "dev:server": "cd apps/server && cargo loco start",
    "db:up": "docker compose up -d db",
    "build": "pnpm --filter @students-connect/web build && cd apps/server && cargo build --release",
    "build:web": "pnpm --filter @students-connect/web build",
    "typecheck": "pnpm -r typecheck",
    "test:web": "pnpm --filter @students-connect/web test",
    "test:server": "cd apps/server && cargo test",
    "lint:server": "cd apps/server && cargo fmt --all --check && cargo clippy --all-targets -- -D warnings"
  }
}
