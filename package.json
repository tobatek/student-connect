{
  "name": "students-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @students-connect/web dev",
    "dev:web": "pnpm --filter @students-connect/web dev",
    "dev:api": "cargo run --manifest-path apps/api/Cargo.toml",
    "build": "pnpm --filter @students-connect/web build && cargo build --manifest-path apps/api/Cargo.toml",
    "build:web": "pnpm --filter @students-connect/web build",
    "build:api": "cargo build --manifest-path apps/api/Cargo.toml",
    "lint": "pnpm --filter @students-connect/web lint && cargo fmt --manifest-path apps/api/Cargo.toml --check",
    "test:api": "cargo test --manifest-path apps/api/Cargo.toml",
    "check:api": "cargo check --manifest-path apps/api/Cargo.toml"
  }
}
